// Merge with the rules already published in Firebase Console; publishing replaces the whole ruleset.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/assessment/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/meal_logs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
